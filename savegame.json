        "name": "暗巷",
        "description": "贫民区的窄巷，阳光难以到达，可疑的身影在阴影中出没。",
        "danger": 4
      },
      {
        "name": "高塔",
        "description": "矗立在城市中心的标志性建筑，从顶端可以俯瞰整个城区。",
        "danger": 2
      },
      {
        "name": "密林深处",
        "description": "参天古树遮天蔽日，粗壮的藤蔓缠绕其间，远处传来不明生物的低吼声。",
        "danger": 4
      },
      {
        "name": "林中空地",
        "description": "阳光透过树冠洒落，地面上散落着营火遗迹和不知名的足迹。",
        "danger": 2
      },
      {
        "name": "巨树",
        "description": "一棵无法估量年龄的巨树拔地而起，树根延伸数十米，树洞深处似有微光闪烁。",
        "danger": 3
      },
      {
        "name": "神殿",
        "description": "祭祀场所，石台上残留着微弱的光芒，祈祷者在此寻求启示。",
        "danger": 3
      }
