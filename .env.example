# LLM 配置
# 支持的 provider: openai, anthropic, groq, deepseek, azure, ollama 等
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_API_BASE=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 按模块覆盖 LLM 配置（可选）
# 格式: LLM_MODULE_<模块名>_<字段>
# LLM_MODULE_narrator_PROVIDER=openai
# LLM_MODULE_narrator_MODEL=gpt-4
# LLM_MODULE_npc_agent_PROVIDER=openai
# LLM_MODULE_npc_agent_MODEL=gpt-4

# 数据库配置
# DB_BACKEND=sqlite
# DB_PATH=jag_world.db

# 游戏配置
# WORLD_NAME=默认世界
# MAX_CHAIN_DEPTH=5
# NPC_CONCURRENCY=5
